generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id                     String                        @id @default(cuid())
  name                   String
  niche                  String
  category               String
  targetAccounts         String[]
  contentMode            ContentMode                   @default(CLIPPER)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  agentRecommendations   AgentRecommendation[]
  agentTasks             AgentTask[]
  assetCollections       AssetCollection[]
  automationPlans        AutomationPlan[]
  contentItems           ContentItem[]
  creativeAssets         CreativeAsset[]
  generationJobs         GenerationJob[]
  mediaJobs              MediaProcessingJob[]
  platformSnapshots      PlatformPerformanceSnapshot[]
  analytics              PostAnalytics[]
  schedules              PostingSchedule[]
  recommendationInsights RecommendationInsight[]
  socialAccounts         SocialAccount[]
  videoSources           VideoSource[]
}

model VideoSource {
  id               String               @id @default(cuid())
  platform         Platform
  url              String
  videoId          String?
  title            String
  thumbnail        String
  embedUrl         String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  projectId        String?
  fileSize         Int?
  mimeType         String?
  originalFileName String?
  sourceFileUrl    String?
  sourceType       VideoSourceType      @default(URL)
  settings         ClipSetting[]
  clips            GeneratedClip[]
  mediaJobs        MediaProcessingJob[]
  schedules        PostingSchedule[]
  project          Project?             @relation(fields: [projectId], references: [id])
}

model ClipSetting {
  id            String          @id @default(cuid())
  videoSourceId String
  prompt        String
  watermark     Boolean         @default(true)
  subtitle      Boolean         @default(true)
  category      String
  clipCount     Int
  duration      Int
  resolution    String
  layout        String          @default("Auto Reframe")
  subtitleStyle String          @default("Bold Creator")
  textPlacement String          @default("Lower Third")
  ccLanguage    String          @default("id-ID")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  videoSource   VideoSource     @relation(fields: [videoSourceId], references: [id], onDelete: Cascade)
  clips         GeneratedClip[]
}

model GeneratedClip {
  id               String               @id @default(cuid())
  videoSourceId    String
  clipSettingId    String?
  title            String
  description      String
  thumbnail        String
  duration         Int
  viralScore       Int
  tags             String[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  endTime          Int?
  errorMessage     String?
  outputFileUrl    String?
  processingStatus ProcessingStatus     @default(COMPLETED)
  startTime        Int?
  subtitleUrl      String?
  thumbnailUrl     String?
  contentItems     ContentItem[]
  clipSetting      ClipSetting?         @relation(fields: [clipSettingId], references: [id])
  videoSource      VideoSource          @relation(fields: [videoSourceId], references: [id], onDelete: Cascade)
  mediaJobs        MediaProcessingJob[]
  postDetails      PostingClipDetail[]
}

model PostingSchedule {
  id                   String                @id @default(cuid())
  videoSourceId        String?
  socialAccountId      String
  destination          Platform
  startDate            DateTime
  postingTime          String
  postingEndTime       String
  timezone             String                @default("Asia/Jakarta")
  videosPerDay         Int
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  projectId            String?
  contentItemId        String?
  scheduledAt          DateTime?
  socialPlatform       SocialPlatform?
  status               ScheduleStatus        @default(DRAFT)
  notes                String                @default("")
  publishMode          PublishMode           @default(MANUAL)
  analytics            PostAnalytics[]
  clipDetails          PostingClipDetail[]
  contentItem          ContentItem?          @relation(fields: [contentItemId], references: [id])
  project              Project?              @relation(fields: [projectId], references: [id])
  socialAccount        SocialAccount         @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  videoSource          VideoSource?          @relation(fields: [videoSourceId], references: [id])
  publishingChecklists PublishingChecklist[]
  publishingJobs       PublishingJob[]
}

model PostingClipDetail {
  id                String          @id @default(cuid())
  postingScheduleId String
  generatedClipId   String
  title             String
  description       String
  tags              String[]
  privacyStatus     PrivacyStatus   @default(PUBLIC)
  notifySubscriber  Boolean         @default(true)
  madeForKids       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  generatedClip     GeneratedClip   @relation(fields: [generatedClipId], references: [id], onDelete: Cascade)
  postingSchedule   PostingSchedule @relation(fields: [postingScheduleId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id                     String                        @id @default(cuid())
  name                   String
  platform               Platform?
  handle                 String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  isActive               Boolean                       @default(true)
  loginNotes             String?
  niche                  String?
  projectId              String?
  socialPlatform         SocialPlatform?
  status                 SocialConnectionStatus        @default(MANUAL)
  disabledAt             DateTime?
  lastActivityAt         DateTime?
  notes                  String                        @default("")
  uploadMethod           UploadMethod                  @default(MANUAL)
  accessTokenEncrypted   String?
  authStatus             AuthStatus                    @default(NOT_CONNECTED)
  connectionNotes        String                        @default("")
  lastSyncAt             DateTime?
  refreshTokenEncrypted  String?
  tokenExpiresAt         DateTime?
  uploadMode             PublishMode                   @default(MANUAL)
  platformAccountAvatar  String?
  platformAccountId      String?
  platformAccountName    String?
  permissionStatus       String                        @default("NOT_REQUESTED")
  automationPlans        AutomationPlan[]
  contentItems           ContentItem[]
  oauthCredentials       OAuthCredential[]
  platformSnapshots      PlatformPerformanceSnapshot[]
  analytics              PostAnalytics[]
  schedules              PostingSchedule[]
  publishingJobs         PublishingJob[]
  recommendationInsights RecommendationInsight[]
  project                Project?                      @relation(fields: [projectId], references: [id])
}

model CreativeAsset {
  id              String          @id @default(cuid())
  projectId       String?
  generationJobId String?
  type            CreativeType
  title           String
  prompt          String
  style           String?
  aspectRatio     String?
  motionPrompt    String?
  provider        AIProviderName?
  thumbnail       String
  previewUrl      String?
  status          AssetStatus     @default(READY)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contentItems    ContentItem[]
  generationJob   GenerationJob?  @relation(fields: [generationJobId], references: [id])
  project         Project?        @relation(fields: [projectId], references: [id])
}

model AIProvider {
  id             String               @id @default(cuid())
  name           AIProviderName       @unique
  apiKey         String?
  status         ProviderStatus       @default(NOT_CONNECTED)
  dailyLimit     Int                  @default(0)
  usedToday      Int                  @default(0)
  resetTime      String               @default("00:00")
  isActive       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  mode           ProviderMode         @default(DUMMY)
  lastTestAt     DateTime?
  lastTestError  String?
  lastTestStatus AIProviderStatus?
  providerStatus AIProviderStatus     @default(NOT_CONFIGURED)
  jobs           GenerationJob[]
  credentials    ProviderCredential[]
}

model ProviderCredential {
  id              String     @id @default(cuid())
  providerId      String
  apiKeyEncrypted String     @default("")
  label           String     @default("default")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  provider        AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model GenerationJob {
  id            String          @id @default(cuid())
  projectId     String?
  providerId    String?
  type          CreativeType
  prompt        String
  status        JobStatus       @default(COMPLETED)
  resultAssetId String?
  errorMessage  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  duration      Int?
  outputUrl     String?
  providerMode  ProviderMode    @default(DUMMY)
  assets        CreativeAsset[]
  project       Project?        @relation(fields: [projectId], references: [id])
  provider      AIProvider?     @relation(fields: [providerId], references: [id])
}

model MediaProcessingJob {
  id              String           @id @default(cuid())
  projectId       String?
  videoSourceId   String?
  generatedClipId String?
  jobType         MediaJobType
  status          ProcessingStatus @default(QUEUED)
  progress        Int              @default(0)
  inputUrl        String
  outputUrl       String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  logs            String[]         @default([])
  generatedClip   GeneratedClip?   @relation(fields: [generatedClipId], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id])
  videoSource     VideoSource?     @relation(fields: [videoSourceId], references: [id])
}

model ContentItem {
  id                     String                  @id @default(cuid())
  projectId              String?
  creativeAssetId        String?
  generatedClipId        String?
  type                   ContentType
  title                  String
  description            String
  thumbnail              String
  status                 ContentStatus           @default(DRAFT)
  platform               SocialPlatform?
  tags                   String[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  caption                String                  @default("")
  approvedAt             DateTime?
  approvedBy             String?
  rejectReason           String                  @default("")
  reviewNotes            String                  @default("")
  workflowStatus         ContentStatus           @default(DRAFT)
  cta                    String                  @default("")
  editingStyle           String                  @default("")
  fypScore               Int?
  hook                   String                  @default("")
  notes                  String                  @default("")
  sourceType             String                  @default("")
  suggestedDuration      Int?
  targetAudience         String                  @default("")
  trendKeyword           String                  @default("")
  trendPlatform          SocialPlatform?
  socialAccountId        String?
  contentAngle           String                  @default("")
  linkedFromContentId    String?
  viralScorePrediction   Int?
  archivedAt             DateTime?
  assetStatus            LibraryAssetStatus      @default(ACTIVE)
  isLatestVersion        Boolean                 @default(true)
  parentAssetId          String?
  trashedAt              DateTime?
  versionNotes           String                  @default("")
  versionNumber          Int                     @default(1)
  approvalMessageId      String?
  approvalStatus         String                  @default("")
  failureReason          String                  @default("")
  publishedAt            DateTime?
  reviewer               String?
  scheduledAt            DateTime?
  telegramChatId         String?
  agentRecommendations   AgentRecommendation[]
  agentTasks             AgentTask[]
  approvalHistory        ApprovalHistory[]
  collectionItems        AssetCollectionItem[]
  creativeAsset          CreativeAsset?          @relation(fields: [creativeAssetId], references: [id])
  generatedClip          GeneratedClip?          @relation(fields: [generatedClipId], references: [id])
  parentAsset            ContentItem?            @relation("ContentItemVersions", fields: [parentAssetId], references: [id])
  versions               ContentItem[]           @relation("ContentItemVersions")
  project                Project?                @relation(fields: [projectId], references: [id])
  socialAccount          SocialAccount?          @relation(fields: [socialAccountId], references: [id])
  analytics              PostAnalytics[]
  schedules              PostingSchedule[]
  publishingChecklists   PublishingChecklist[]
  publishingJobs         PublishingJob[]
  recommendationInsights RecommendationInsight[]
  telegramApprovalLogs   TelegramApprovalLog[]
}

model AIAgent {
  id              String                @id @default(cuid())
  name            String
  role            AgentRole
  description     String
  status          AgentStatus           @default(ACTIVE)
  lastRunAt       DateTime?
  totalTasks      Int                   @default(0)
  successRate     Float                 @default(96)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  recommendations AgentRecommendation[]
  tasks           AgentTask[]
  automationPlans AutomationPlan[]
}

model AgentTask {
  id            String          @id @default(cuid())
  agentId       String
  projectId     String?
  contentItemId String?
  taskType      AgentTaskType
  title         String
  description   String
  status        AgentTaskStatus @default(COMPLETED)
  result        String          @default("")
  priority      AgentPriority   @default(MEDIUM)
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  agent         AIAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contentItem   ContentItem?    @relation(fields: [contentItemId], references: [id])
  project       Project?        @relation(fields: [projectId], references: [id])
}

model AgentRecommendation {
  id                 String        @id @default(cuid())
  agentId            String
  projectId          String?
  contentItemId      String?
  title              String
  description        String
  recommendationType String
  priority           AgentPriority @default(MEDIUM)
  score              Int           @default(80)
  status             String        @default("OPEN")
  createdAt          DateTime      @default(now())
  agent              AIAgent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contentItem        ContentItem?  @relation(fields: [contentItemId], references: [id])
  project            Project?      @relation(fields: [projectId], references: [id])
}

model TelegramSetting {
  id                String         @id @default(cuid())
  botTokenEncrypted String         @default("")
  chatId            String         @default("")
  status            TelegramStatus @default(NOT_CONNECTED)
  lastTestAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model GoogleOAuthSetting {
  id                    String         @id @default(cuid())
  clientIdEncrypted     String         @default("")
  clientSecretEncrypted String         @default("")
  redirectUri           String         @default("")
  status                ProviderStatus @default(NOT_CONNECTED)
  lastTestAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model OAuthCredential {
  id                    String        @id @default(cuid())
  provider              String
  socialAccountId       String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  scope                 String
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  socialAccount         SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model OAuthProviderSetting {
  id                    String         @id @default(cuid())
  provider              String         @unique
  clientIdEncrypted     String         @default("")
  clientSecretEncrypted String         @default("")
  redirectUri           String         @default("")
  status                ProviderStatus @default(NOT_CONNECTED)
  lastTestAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model AutomationPlan {
  id                   String               @id @default(cuid())
  projectId            String?
  socialAccountId      String?
  title                String
  description          String
  suggestedPlatform    SocialPlatform?
  suggestedPostingTime String
  reason               String
  priority             AgentPriority        @default(MEDIUM)
  status               AutomationPlanStatus @default(DRAFT)
  createdByAgentId     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdByAgent       AIAgent?             @relation(fields: [createdByAgentId], references: [id])
  project              Project?             @relation(fields: [projectId], references: [id])
  socialAccount        SocialAccount?       @relation(fields: [socialAccountId], references: [id])
}

model TelegramApprovalLog {
  id                String                 @id @default(cuid())
  contentItemId     String
  action            TelegramApprovalAction
  telegramMessageId String?
  telegramChatId    String?
  status            TelegramLogStatus      @default(PENDING)
  responseBy        String?
  responseAt        DateTime?
  errorMessage      String?
  createdAt         DateTime               @default(now())
  contentItem       ContentItem            @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
}

model AssetCollection {
  id          String                @id @default(cuid())
  name        String
  description String                @default("")
  projectId   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  project     Project?              @relation(fields: [projectId], references: [id])
  items       AssetCollectionItem[]
}

model AssetCollectionItem {
  id            String          @id @default(cuid())
  collectionId  String
  contentItemId String
  createdAt     DateTime        @default(now())
  collection    AssetCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contentItem   ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, contentItemId])
}

model ApprovalHistory {
  id            String        @id @default(cuid())
  contentItemId String
  fromStatus    ContentStatus
  toStatus      ContentStatus
  note          String        @default("")
  reason        String        @default("")
  actionBy      String        @default("Admin")
  createdAt     DateTime      @default(now())
  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
}

model PostAnalytics {
  id                  String           @id @default(cuid())
  projectId           String?
  contentItemId       String
  socialAccountId     String
  postingScheduleId   String?
  platform            SocialPlatform
  views               Int              @default(0)
  likes               Int              @default(0)
  comments            Int              @default(0)
  shares              Int              @default(0)
  saves               Int              @default(0)
  watchTime           Int              @default(0)
  engagementRate      Float            @default(0)
  capturedAt          DateTime         @default(now())
  createdAt           DateTime         @default(now())
  averageViewDuration Float            @default(0)
  followersGained     Int              @default(0)
  notes               String           @default("")
  postUrl             String           @default("")
  postedAt            DateTime?
  recordedAt          DateTime         @default(now())
  contentItem         ContentItem      @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  postingSchedule     PostingSchedule? @relation(fields: [postingScheduleId], references: [id])
  project             Project?         @relation(fields: [projectId], references: [id])
  socialAccount       SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model PlatformPerformanceSnapshot {
  id                 String         @id @default(cuid())
  projectId          String?
  socialAccountId    String?
  campaignId         String?
  generatedContentId String?
  productName        String         @default("")
  platform           SocialPlatform
  views              Int            @default(0)
  likes              Int            @default(0)
  comments           Int            @default(0)
  shares             Int            @default(0)
  saves              Int            @default(0)
  clicks             Int            @default(0)
  sales              Int            @default(0)
  commission         Float          @default(0)
  watchTime          Int            @default(0)
  engagementRate     Float          @default(0)
  snapshotDate       DateTime       @default(now())
  createdAt          DateTime       @default(now())
  project            Project?       @relation(fields: [projectId], references: [id])
  socialAccount      SocialAccount? @relation(fields: [socialAccountId], references: [id])

  @@index([campaignId, snapshotDate])
  @@index([generatedContentId, snapshotDate])
}

model RecommendationInsight {
  id              String         @id @default(cuid())
  projectId       String?
  socialAccountId String?
  contentItemId   String?
  insightType     String
  title           String
  description     String
  score           Int
  recommendation  String
  priority        String
  createdAt       DateTime       @default(now())
  contentItem     ContentItem?   @relation(fields: [contentItemId], references: [id])
  project         Project?       @relation(fields: [projectId], references: [id])
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
}

model PublishingChecklist {
  id                String           @id @default(cuid())
  contentItemId     String
  postingScheduleId String?
  assetChecked      Boolean          @default(false)
  captionCopied     Boolean          @default(false)
  hashtagCopied     Boolean          @default(false)
  uploadedManually  Boolean          @default(false)
  postUrlAdded      Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  contentItem       ContentItem      @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  postingSchedule   PostingSchedule? @relation(fields: [postingScheduleId], references: [id])
}

model PublishingJob {
  id                 String              @id @default(cuid())
  postingScheduleId  String
  contentItemId      String
  socialAccountId    String
  platform           SocialPlatform
  publishMode        PublishMode
  status             PublishingJobStatus @default(READY_TO_POST)
  providerJobId      String?
  postUrl            String              @default("")
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  platformPostId     String?
  platformPostUrl    String?
  publishCompletedAt DateTime?
  publishStartedAt   DateTime?
  retryCount         Int                 @default(0)
  contentItem        ContentItem         @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  postingSchedule    PostingSchedule     @relation(fields: [postingScheduleId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  logs               PublishingLog[]
}

model PublishingLog {
  id              String             @id @default(cuid())
  publishingJobId String
  level           PublishingLogLevel @default(INFO)
  message         String
  metadata        Json?
  createdAt       DateTime           @default(now())
  publishingJob   PublishingJob      @relation(fields: [publishingJobId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  severity  String   @default("INFO")
  source    String
  status    String   @default("UNREAD")
  actionUrl String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model IntelligenceResult {
  id             String                 @id @default(cuid())
  keyword        String
  topic          String
  platform       String
  source         String
  sourceUrl      String?
  score          Int
  confidence     Int
  volumeLabel    String
  trendDirection String
  category       String
  region         String
  language       String
  collectedAt    DateTime
  rawData        Json?
  isDemo         Boolean                @default(true)
  notes          String                 @default("")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  searchRunId    String?
  analyses       DataDrivenAnalysis[]
  searchRun      IntelligenceSearchRun? @relation(fields: [searchRunId], references: [id])

  @@index([platform, collectedAt])
  @@index([keyword, collectedAt])
  @@index([searchRunId, collectedAt])
}

model IntelligenceSearchRun {
  id          String               @id @default(cuid())
  query       String
  niche       String               @default("")
  mode        String
  platforms   String[]
  region      String
  language    String
  timeRange   String
  status      String
  resultCount Int                  @default(0)
  cacheKey    String               @unique
  cachedUntil DateTime
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  results     IntelligenceResult[]

  @@index([query, region, createdAt])
  @@index([cachedUntil])
}

model DataDrivenAnalysis {
  id               String              @id @default(cuid())
  resultId         String?
  keyword          String
  mode             String
  summary          String
  trendStage       String
  opportunityLevel String
  riskLevel        String
  score            Int
  confidence       Int
  analysis         Json
  sourceBreakdown  Json
  isDemo           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  result           IntelligenceResult? @relation(fields: [resultId], references: [id])

  @@index([resultId, createdAt])
  @@index([keyword, createdAt])
}

model AffiliateProductInsight {
  id                    String   @id @default(cuid())
  productName           String
  platform              String
  category              String
  sourceType            String   @default("DEMO")
  productUrl            String?
  affiliateUrl          String?
  price                 Float?
  commissionRate        Float?
  revenue               Float?
  salesVolume           Int?
  demandScore           Int?
  trendScore            Int
  competitionLevel      String
  competitionScore      Int?
  commissionEstimate    String
  commissionScore       Int?
  priceRange            String
  contentPotentialScore Int
  opportunityScore      Int?
  isEstimated           Boolean  @default(true)
  lastSyncedAt          DateTime?
  source                String
  sourceUrl             String?
  confidence            Int
  collectedAt           DateTime
  isDemo                Boolean  @default(true)
  notes                 String   @default("")
  rawData               Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([platform, collectedAt])
  @@index([category, collectedAt])
  @@index([sourceType, lastSyncedAt])
}

model IntelligenceProviderSetting {
  id              String    @id @default(cuid())
  provider        String    @unique
  apiKeyEncrypted String?
  status          String    @default("MISSING")
  lastError       String?
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model YouTubeQuotaLog {
  id            String   @id @default(cuid())
  endpoint      String
  keyword       String
  region        String
  estimatedCost Int
  status        String
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([endpoint, createdAt])
}

model SavedOpportunity {
  id               String             @id @default(cuid())
  title            String
  type             String
  source           String
  sourceUrl        String?
  platform         String
  score            Int
  confidence       Int
  reason           String
  notes            String             @default("")
  isDemo           Boolean            @default(true)
  status           String             @default("saved")
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  generatedContent GeneratedContent[]

  @@index([type, createdAt])
  @@index([status, createdAt])
}

model AffiliateCampaign {
  id                    String             @id @default(cuid())
  campaignName          String
  productName           String
  platform              String
  category              String
  trendScore            Int
  competitionLevel      String
  commissionEstimate    String
  priceRange            String
  contentPotentialScore Int
  source                String
  sourceUrl             String?
  notes                 String             @default("")
  isDemo                Boolean            @default(true)
  status                String             @default("draft")
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  generatedContent      GeneratedContent[]
  campaignAccounts      CampaignAccount[]

  @@index([status, createdAt])
  @@index([platform, createdAt])
}

model AffiliateProgram {
  id             String             @id @default(cuid())
  name           String
  website        String
  dashboardUrl   String
  affiliateLink  String
  commissionInfo String             @default("")
  products       Json?
  notes          String             @default("")
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  accounts       AffiliateAccount[]

  @@index([status, updatedAt])
}

model AffiliateAccount {
  id                    String            @id @default(cuid())
  programId             String?
  platform              String
  accountName           String
  handle                String
  niche                 String
  role                  String
  affiliateDashboardUrl String?
  affiliateLink         String?
  commissionInfo        String            @default("")
  notes                 String            @default("")
  status                String            @default("ACTIVE")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  program               AffiliateProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  campaignAccounts      CampaignAccount[]

  @@index([platform, status])
  @@index([programId, updatedAt])
}

model CampaignAccount {
  id                 String            @id @default(cuid())
  campaignId         String
  affiliateAccountId String
  createdAt          DateTime          @default(now())
  campaign           AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliateAccount   AffiliateAccount  @relation(fields: [affiliateAccountId], references: [id], onDelete: Cascade)

  @@unique([campaignId, affiliateAccountId])
  @@index([affiliateAccountId, createdAt])
}

model GeneratedContent {
  id            String             @id @default(cuid())
  campaignId    String?
  opportunityId String?
  contentType   String
  title         String
  body          String
  platform      String
  tone          String
  source        String
  isDemo        Boolean            @default(true)
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  campaign      AffiliateCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  opportunity   SavedOpportunity?  @relation(fields: [opportunityId], references: [id])

  @@index([campaignId, contentType])
  @@index([opportunityId, contentType])
}

model KnowledgeEntry {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  category    String
  topic       String
  niche       String
  platform    String
  content     Json
  tags        String[]
  confidence  Int      @default(70)
  sourceType  String   @default("ENGINE")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, updatedAt])
  @@index([platform, updatedAt])
  @@index([tags], type: Gin)
}

