# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&uselibpqcompat=true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Providers. Leave blank for dummy/manual mode.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
YOUTUBE_API_KEY=""

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/youtube/callback"

# TikTok OAuth
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"

# Meta / Instagram / Facebook OAuth
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"

# Reddit OAuth. Server-side foundation only; scraping is not used.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="ai-clipper-dashboard/0.1 by your-reddit-username"

# Telegram approval
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Use a long random value in production. Do not commit the real key.
ENCRYPTION_KEY=""
