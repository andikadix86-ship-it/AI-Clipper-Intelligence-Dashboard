# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&uselibpqcompat=true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only AI providers. Never expose these as NEXT_PUBLIC values.
# GEMINI_API_KEY enables real Gemini text/image analysis; blank keeps Gemini disabled/fallback.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Server-only public data sources.
# YOUTUBE_API_KEY is required for real YouTube intelligence. Google OAuth alone is only for account upload/auth flows.
YOUTUBE_API_KEY=""
# Optional legacy alias. Prefer YOUTUBE_API_KEY.
YOUTUBE_DATA_API_KEY=""
# Optional Google Trends endpoint. When blank, Google Trends stays disabled/demo because there is no generally available official API.
GOOGLE_TRENDS_API_URL=""

# YouTube / Google OAuth. These do not replace YOUTUBE_API_KEY for YouTube Data API search.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/youtube/callback"

# TikTok OAuth
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"

# Meta / Instagram / Facebook OAuth
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"

# Reddit OAuth. Optional additional insight source only; scraping is not used.
# Leave blank to keep Reddit in Not Configured fallback/demo mode.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="ai-clipper-dashboard/0.1 by your-reddit-username"

# Telegram approval
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Use a long random value in production. Do not commit the real key.
ENCRYPTION_KEY=""
